# ─── Locale ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_LOCALES=en,es

# ─── LLM Provider Configuration (server-side only, never use NEXT_PUBLIC_) ────
# Set LLM_PROVIDER to one of: openai | anthropic | gemini | groq
# Set LLM_MODEL to override the default model for the chosen provider.
# Add the API key for your chosen provider below.

LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=AIza...

# Groq
# GROQ_API_KEY=gsk_...
