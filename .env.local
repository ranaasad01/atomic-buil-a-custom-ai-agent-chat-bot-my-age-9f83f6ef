# ─── Locale ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_LOCALES=en,es

# ─── LLM Provider Configuration (server-side only, never use NEXT_PUBLIC_) ────
# Set LLM_PROVIDER to one of: openai | anthropic | gemini | groq
# Set LLM_MODEL to override the default model for the chosen provider.

LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# Google Gemini
# GEMINI_API_KEY=AIza...

# Groq
# GROQ_API_KEY=gsk_...
